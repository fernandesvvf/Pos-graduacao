{
  "name": "@you/standalone-mcp",
  "version": "0.0.1",
  "description": "MCP server template (standalone-tool preset) — flat, no backend, pure tool (aula 05 style)",
  "type": "module",
  "bin": {
    "standalone-mcp": "./src/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --inspect src/index.ts",
    "test": "node --test tests/**/*.test.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node src/index.ts"
  },
  "keywords": ["mcp", "model-context-protocol", "template"],
  "license": "ISC",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/node": "^24.11.0",
    "zod": "^3.25.76"
  }
}
